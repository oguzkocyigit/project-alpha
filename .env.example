# Neon (or any) Postgres connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin login
ADMIN_USERNAME="coach"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: escape every "$" as "\$" below — Next.js expands unescaped $VAR
# patterns in .env files, which corrupts bcrypt hashes (they're full of $).
ADMIN_PASSWORD_HASH="\$2a\$10\$replace_with_generated_hash"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_random_32byte_hex"
